#connection { width: 100%; height: 100%; align-items: center; justify-content: center; background-color: #161c33 }
.box { width: 520; padding: 32; gap: 16; background-color: #d4d7e7 }
.head { font-size: 38; color: #1d2441 }
#progress { width: 100%; white-space: normal; font-size: 17; color: #3e3b61 }
button { height: 44; background-color: #32304e; color: #dcdeec }
