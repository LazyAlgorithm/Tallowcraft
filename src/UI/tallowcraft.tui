          </panel>
          <panel class="controls"><text id="selection-note">Select an item stack, then select its destination</text></panel>
          <panel class="controls actions">
            <button id="half_button" class="secondary" onclick="OnHalf">Move half: OFF</button>
            <button id="cancel_button" class="secondary" onclick="OnCancel">Cancel selection</button>
            <button id="active_button" class="secondary" onclick="OnActive">Set hotbar active</button>
          </panel>
          <panel class="controls reserve">
            <text id="reserve-info">Legacy reserve: empty</text>
            <button id="reserve-button" class="secondary" onclick="OnUnpack">Unpack</button>
          </panel>
        </panel>
        <panel class="detail-column">
          <panel id="page_craft" class="detail">
            <text class="section-title">CRAFTING</text>
            <text class="subtle">Choose a recipe. Ingredients come from your whole inventory.</text>
            <panel class="recipe-scroll-controls">
              <button id="recipe-scroll-up" class="recipe-scroll-button" onclick="OnRecipeScrollUp">▲</button>
              <slider id="recipe-scrollbar" class="recipe-scrollbar" min="0" max="4" step="1" onchange="OnRecipeScroll" />
              <button id="recipe-scroll-down" class="recipe-scroll-button" onclick="OnRecipeScrollDown">▼</button>
              <text id="recipe-scroll-status" class="recipe-scroll-status">Recipes 1–4 of 8</text>
            </panel>
            <panel class="recipes">
              <button id="recipe_1" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/planks.png"/><panel><text class="recipe-title">Wooden planks</text><text class="recipe-sub">1 log  ->  4 planks</text></panel></button>
              <button id="recipe_2" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/grass.png"/><panel><text class="recipe-title">Grass blocks</text><text class="recipe-sub">Dirt + leaves</text></panel></button>
              <button id="recipe_3" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/forge.png"/><panel><text class="recipe-title">Stone forge</text><text class="recipe-sub">8 stone + 2 iron ore</text></panel></button>
              <button id="recipe_6" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/chest_item.png"/><panel><text class="recipe-title">Storage chest</text><text class="recipe-sub">8 planks  ->  1 chest</text></panel></button>
              <button id="recipe_7" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/cobblestone.png"/><panel><text class="recipe-title">Cobblestone</text><text class="recipe-sub">2 stone  ->  2 cobblestone</text></panel></button>
              <button id="recipe_8" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/stone_bricks.png"/><panel><text class="recipe-title">Stone bricks</text><text class="recipe-sub">4 stone  ->  4 bricks</text></panel></button>
              <button id="recipe_9" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/mossy_stone.png"/><panel><text class="recipe-title">Mossy stone</text><text class="recipe-sub">3 cobblestone + 1 leaves  ->  4</text></panel></button>
              <button id="recipe_10" class="recipe" onclick="OnRecipe"><image class="recipe-image" src="Textures/UI/dark_timber.png"/><panel><text class="recipe-title">Dark timber</text><text class="recipe-sub">2 logs  ->  4 timber</text></panel></button>
            </panel>
            <text class="section-title">STONE TOOLS</text>
            <panel class="tool-list">
              <panel class="tool-row"><text id="tool_info_1">Stone pickaxe</text><button id="tool_equip_1" onclick="OnEquip">Equip</button><button id="tool_make_1" onclick="OnTool">Craft</button></panel>
              <panel class="tool-row"><text id="tool_info_2">Stone axe</text><button id="tool_equip_2" onclick="OnEquip">Equip</button><button id="tool_make_2" onclick="OnTool">Craft</button></panel>
              <panel class="tool-row"><text id="tool_info_3">Stone shovel</text><button id="tool_equip_3" onclick="OnEquip">Equip</button><button id="tool_make_3" onclick="OnTool">Craft</button></panel>
            </panel>
          </panel>
          <panel id="page_forge" class="detail">
            <text class="section-title">FORGE + SMELTING</text>
            <text id="forge-status" class="subtle">Stand within 3.5m of a placed forge.</text>
            <panel class="smelt">
              <image class="recipe-image" src="Textures/UI/iron_ore.png" />
              <text class="recipe-arrow">+</text>
              <image class="recipe-image" src="Textures/UI/coal.png" />
              <text class="recipe-arrow">=</text>
              <image class="recipe-image" src="Textures/UI/iron_ingot.png" />
            </panel>
            <text id="smelt-info" class="subtle">1 iron ore + 1 coal = 1 iron ingot</text>
            <panel class="controls"><button id="smelt_1" class="primary" onclick="OnSmelt">Smelt 1</button><button id="smelt_5" class="primary" onclick="OnSmelt">Smelt 5</button></panel>
            <text class="section-title">IRON TOOLS</text>
            <panel class="tool-list">
              <panel class="tool-row"><text id="tool_info_4">Iron pickaxe</text><button id="tool_equip_4" onclick="OnEquip">Equip</button><button id="tool_make_4" onclick="OnTool">Craft</button></panel>
              <panel class="tool-row"><text id="tool_info_5">Iron axe</text><button id="tool_equip_5" onclick="OnEquip">Equip</button><button id="tool_make_5" onclick="OnTool">Craft</button></panel>
              <panel class="tool-row"><text id="tool_info_6">Iron shovel</text><button id="tool_equip_6" onclick="OnEquip">Equip</button><button id="tool_make_6" onclick="OnTool">Craft</button></panel>
            </panel>
          </panel>
          <panel id="page_chest" class="detail">
            <text class="section-title">NEARBY STORAGE</text>
