<!-- Tallowcraft inventory UI. All item images are real 32px assets.
     The C# code-behind toggles one image per slot; the .tui API has no
     dynamic image-src setter. Grid coordinates are authored explicitly,
     so native .tui click events handle every slot. -->
<panel id="screen">
  <panel id="fps-counter" class="fps-counter"><text id="fps-value">FPS --</text></panel>
  <panel id="navigation-hud" class="navigation-hud">
    <text id="hud-coordinates" class="nav-coordinates">XYZ --, --, --</text>
    <text id="hud-waypoint" class="nav-target">Pause > Waypoints</text>
    <text id="hud-pick-feedback" class="nav-feedback"></text>
  </panel>
  <panel id="compass-ribbon" class="compass-ribbon">
    <panel class="compass-track">
      <panel class="compass-tick-track">
        <panel class="compass-bin"><text id="compass-tick-0" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-1" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-2" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-3" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-4" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-5" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-6" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-7" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-8" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-9" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-10" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-11" class="compass-tick">·</text></panel>
        <panel class="compass-bin"><text id="compass-tick-12" class="compass-tick">·</text></panel>
      </panel>
      <panel class="compass-marker-track">
        <panel class="compass-marker-bin">
          <image id="compass-marker-0-0" class="compass-marker compass-marker-0" src="Textures/UI/Waypoints/home.png" />
          <image id="compass-marker-1-0" class="compass-marker compass-marker-1" src="Textures/UI/Waypoints/building.png" />
          <image id="compass-marker-2-0" class="compass-marker compass-marker-2" src="Textures/UI/Waypoints/mine.png" />
          <image id="compass-marker-3-0" class="compass-marker compass-marker-3" src="Textures/UI/Waypoints/landmark.png" />
