<!-- Tallowcraft inventory UI. All item images are real 32px assets.
     The C# code-behind toggles one image per slot; the .tui API has no
     dynamic image-src setter. Grid coordinates are authored explicitly,
     so native .tui click events handle every slot. -->
<panel id="screen">
  <text id="crosshair">+</text>
  <panel id="hud" class="hud">
    <panel class="hud-title"><text id="hud-name">TALLOWCRAFT</text><text id="hud-status"></text></panel>
    <panel class="slot-row"><button id="h_0_0" class="hud-slot" onclick="OnSlot"><text class="slot-key">1</text><panel class="slot-art"><image id="h_0_0_type1" class="slot-icon" src="Textures/UI/grass.png" /><image id="h_0_0_type2" class="slot-icon" src="Textures/UI/dirt.png" /><image id="h_0_0_type3" class="slot-icon" src="Textures/UI/stone.png" /><image id="h_0_0_type4" class="slot-icon" src="Textures/UI/log.png" /><image id="h_0_0_type5" class="slot-icon" src="Textures/UI/forge.png" /><image id="h_0_0_type6" class="slot-icon" src="Textures/UI/planks.png" /><image id="h_0_0_type7" class="slot-icon" src="Textures/UI/coal.png" /><image id="h_0_0_type8" class="slot-icon" src="Textures/UI/iron_ore.png" /><image id="h_0_0_type9" class="slot-icon" src="Textures/UI/leaves.png" /><image id="h_0_0_type10" class="slot-icon" src="Textures/UI/iron_ingot.png" /><image id="h_0_0_type11" class="slot-icon" src="Textures/chest_item.png" /></panel><text id="h_0_0_count" class="slot-count"></text><panel id="h_0_0_selected" class="slot-focus"></panel></button><button id="h_0_1" class="hud-slot" onclick="OnSlot"><text class="slot-key">2</text><panel class="slot-art"><image id="h_0_1_type1" class="slot-icon" src="Textures/UI/grass.png" /><image id="h_0_1_type2" class="slot-icon" src="Textures/UI/dirt.png" /><image id="h_0_1_type3" class="slot-icon" src="Textures/UI/stone.png" /><image id="h_0_1_type4" class="slot-icon" src="Textures/UI/log.png" /><image id="h_0_1_type5" class="slot-icon" src="Textures/UI/forge.png" /><image id="h_0_1_type6" class="slot-icon" src="Textures/UI/planks.png" /><image id="h_0_1_type7" class="slot-icon" src="Textures/UI/coal.png" /><image id="h_0_1_type8" class="slot-icon" src="Textures/UI/iron_ore.png" /><image id="h_0_1_type9" class="slot-icon" src="Textures/UI/leaves.png" /><image id="h_0_1_type10" class="slot-icon" src="Textures/UI/iron_ingot.png" /><image id="h_0_1_type11" class="slot-icon" src="Textures/chest_item.png" /></panel><text id="h_0_1_count" c