  <panel id="notice-panel" class="notice"><text id="notice">Loading your saved inventory...</text></panel>
  <panel id="overlay" class="overlay">
    <panel id="game-menu" class="game-menu">
      <text class="game-menu-kicker">A BLOCK WORLD TO MAKE YOUR OWN</text>
      <text class="game-menu-title">TALLOWCRAFT</text>
      <text id="game-menu-subtitle" class="game-menu-subtitle">Explore, build, and shape your world.</text>
      <panel id="game-menu-actions" class="game-menu-actions">
        <button id="play-game" class="game-menu-button" onclick="OnPlay">Play world</button>
        <button id="resume-game" class="game-menu-button" onclick="OnResume">Resume game</button>
        <button id="open-settings" class="game-menu-button-secondary" onclick="OnSettings">World settings</button>
        <button id="open-waypoints" class="game-menu-button-secondary" onclick="OnWaypoints">Waypoints and coordinates</button>
        <button id="respawn-menu-button" class="game-menu-button-secondary" onclick="OnRespawnPrompt">Return to spawn</button>
        <button id="quit-game" class="game-menu-button-quit" onclick="OnQuit">Quit game</button>
      </panel>
      <panel id="world-settings" class="world-settings">
        <text class="settings-title">WORLD SETTINGS</text>
        <text class="settings-help">Changes apply immediately.</text>
        <button id="view-setting" class="setting-button" onclick="OnViewDistance">View distance: Balanced</button>
        <button id="lod-setting" class="setting-button" onclick="OnTerrainLod">Quadtree terrain LOD: On</button>
        <button id="lod-quality-setting" class="setting-button" onclick="OnLodQuality">LOD quality: Balanced</button>
        <button id="height-setting" class="setting-button" onclick="OnWorldHeight">Vertical range: Balanced</button>
        <button id="shadow-setting" class="setting-button" onclick="OnShadows">Block shadows: On</button>
        <button id="threads-setting" class="setting-button" onclick="OnThreads">Chunk threads: Auto</button>
        <text class="settings-help">Higher settings may reduce FPS.</text>
        <button id="back-settings" class="game-menu-button-secondary" onclick="OnSettings">Back</button>
      </panel>
      <panel id="waypoint-panel" class="world-settings">
        <text class="settings-title">EXPLORATION WAYPOINTS</text>
        <text id="waypoint-status" class="settings-help">Mark your favorite places.</text>
        <text class="waypoint-help">Mark here saves your current location. Track displays its distance on the HUD.</text>
        <panel class="waypoint-list">
          <panel class="waypoint-row">
            <text id="waypoint-info-0" class="waypoint-position">Home: not marked</text>
            <panel class="waypoint-actions">
              <button id="waypoint-track-0" class="waypoint-button" onclick="OnTrackWaypoint">Track</button>
              <button id="waypoint-set-0" class="waypoint-button waypoint-set" onclick="OnSetWaypoint">Mark here</button>
              <button id="waypoint-clear-0" class="waypoint-button waypoint-clear" onclick="OnClearWaypoint">Clear</button>
            </panel>
          </panel>
          <panel class="waypoint-row">
            <text id="waypoint-info-1" class="waypoint-position">Building site: not marked</text>
            <panel class="waypoint-actions">
              <button id="waypoint-track-1" class="waypoint-button" onclick="OnTrackWaypoint">Track</button>
              <button id="waypoint-set-1" class="waypoint-button waypoint-set" onclick="OnSetWaypoint">Mark here</button>
              <button id="waypoint-clear-1" class="waypoint-button waypoint-clear" onclick="OnClearWaypoint">Clear</button>
            </panel>
          </panel>
          <panel class="waypoint-row">
            <text id="waypoint-info-2" class="waypoint-position">Mine: not marked</text>
            <panel class="waypoint-actions">
              <button id="waypoint-track-2" class="waypoint-button" onclick="OnTrackWaypoint">Track</button>
              <button id="waypoint-set-2" class="waypoint-button waypoint-set" onclick="OnSetWaypoint">Mark here</button>
              <button id="waypoint-clear-2" class="waypoint-button waypoint-clear" onclick="OnClearWaypoint">Clear</button>
            </panel>
          </panel>
          <panel class="waypoint-row">
            <text id="waypoint-info-3" class="waypoint-position">Landmark: not marked</text>
            <panel class="waypoint-actions">
              <button id="waypoint-track-3" class="waypoint-button" onclick="OnTrackWaypoint">Track</button>
              <button id="waypoint-set-3" class="waypoint-button waypoint-set" onclick="OnSetWaypoint">Mark here</button>
              <button id="waypoint-clear-3" class="waypoint-button waypoint-clear" onclick="OnClearWaypoint">Clear</button>
            </panel>
          </panel>
        </panel>
        <button id="back-waypoints" class="game-menu-button-secondary" onclick="OnBackWaypoints">Back</button>
      </panel>
      <panel id="respawn-confirm" class="world-settings">
        <text class="settings-title">RETURN TO SPAWN?</text>
        <text class="waypoint-help">Travel back to your original spawn point. Your items and builds stay where they are. This does not affect other players.</text>
        <button id="confirm-respawn" class="game-menu-button" onclick="OnConfirmRespawn">Return to spawn</button>
        <button id="cancel-respawn" class="game-menu-button-secondary" onclick="OnCancelRespawn">Cancel</button>
      </panel>
      <text class="game-menu-footer">ESC pauses  •  TAB opens inventory</text>
    </panel>
    <panel id="inventory-panel" class="inventory-shell">
      <panel class="menu-header">
        <panel class="heading"><text class="eyebrow">TALLOWCRAFT / SURVIVAL</text><text class="menu-title">Inventory</text></panel>
        <panel class="tabs">
          <button id="tab_craft" class="tab" onclick="OnTab">Crafting</button>
          <button id="tab_forge" class="tab" onclick="OnTab">Forge</button>
          <button id="tab_chest" class="tab" onclick="OnTab">Storage</button>
          <button id="close_menu" class="close" onclick="OnClose">X</button>
        </panel>
      </panel>
      <panel class="menu-content">
        <panel class="player-column">
          <panel class="section-heading"><text class="section-title">YOUR BACKPACK</text><text id="inventory-total" class="subtle">36 slots</text></panel>
