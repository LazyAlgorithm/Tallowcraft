#screen { width: 100%; height: 100%; justify-content: center; align-items: center; background-color: #161c33 }
.book { width: 1060; height: 574; flex-direction: row; background-color: #d4d7e7; border-width: 2; border-color: #8e6ccb }
.print { width: 575; height: 570; background-color: #1f2747 }
.ridge { width: 575; height: 385 }
.caption { padding: 26 32; gap: 6 }
.brand { font-size: 62; color: #c8cbe0 }
.legend { font-size: 18; color: #b4b2d0 }
.choices { width: 480; padding: 36; gap: 14; justify-content: center }
.heading { font-size: 44; color: #1d2441 }
.description { width: 100%; white-space: normal; font-size: 17; color: #3e3b61 }
.start, .join, .exit { width: 100%; height: 46; font-size: 19; border-radius: 3 }
.start { background-color: #32304e; color: #e6e7f1 }
.join { background-color: #a184d4; color: #1f2747 }
.exit { color: #434069; background-color: #c7cae0 }
.rule { width: 100%; height: 2; background-color: #a184d4 }
.choice-stack { width: 100%; gap: 14 }
.friends-status { width: 100%; white-space: normal; color: #58607a; font-size: 16 }
.friend-row { width: 100%; height: 38; background-color: #dcdeec; color: #21233d; font-size: 17 }
.friend-nav { flex-direction: row; gap: 8 }
.friend-nav button { width: 110; height: 32; font-size: 14; color: #f6f7fa; background-color: #4d4874 }

#screen { background-color: #0d1021 }
.book { background-color: #1e2239; border-color: #505577 }
.print, .caption { background-color: #151a30 }
.brand, .heading { color: #edeefa }
.legend, .description, .friends-status { color: #b8bfd8 }
.start { background-color: #ad94ff; color: #14132c }
.join, .friend-row { background-color: #343854; color: #e5e6fa }
.exit { background-color: #252940; color: #c5c8df }
.rule { background-color: #474b69 }
